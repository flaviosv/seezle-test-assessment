{
  "info": {
    "name": "Seezle Test Assessment",
    "description": "Calculator MVP API — POST /v1/calculate. Run against `docker compose up` (backend on :8090) or `go run ./main.go`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "api_base_url", "value": "http://localhost:8090", "type": "string" }
  ],
  "item": [
    {
      "name": "Success",
      "item": [
        {
          "name": "2+2 = 4",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"operation\":\"2+2\"}" },
            "url": { "raw": "{{api_base_url}}/v1/calculate", "host": ["{{api_base_url}}"], "path": ["v1", "calculate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200))",
                  "pm.test('result is 4', () => pm.expect(pm.response.json().result).to.eql(4))"
                ]
              }
            }
          ]
        }
      ]
    },
