        },
        {
          "name": "4+16\\\\ = 8 (postfix binds only to its own term, not the running total)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"operation\":\"4+16\\\\\"}" },
