          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200))", "pm.test('result is 8 (4 + sqrt(16), not 4 + 16 then sqrt)', () => pm.expect(pm.response.json().result).to.eql(8))"] } }]
        }
